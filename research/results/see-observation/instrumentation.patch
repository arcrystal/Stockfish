+// Diagnostic only; run with exactly one search worker. Never changes SEE results.
+struct SeeReuseObservation {
+    unsigned long long qnodes = 0, firstCalls = 0, firstPasses = 0;
+    unsigned long long finalCalls = 0, eligible = 0, violations = 0;
+    unsigned long long attackEntries[3]{}, loopIterations[3]{};
+    int mode = 0; // 0 other SEE, 1 noneligible final SEE, 2 eligible final SEE
