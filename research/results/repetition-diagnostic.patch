+        repetitionDiagnostic.continued.fetch_add(1, std::memory_order_relaxed);
     }
 
+    auto diagnosticReturn = [&](Value returned, bool ttReturn) {
+        if (returned >= diagnosticRepetitionValue)
+            return;
+        auto& counter = ttReturn ? repetitionDiagnostic.ttBelow : repetitionDiagnostic.finalBelow;
+        counter.fetch_add(1, std::memory_order_relaxed);
+        if (repetitionDiagnostic.samples.fetch_add(1, std::memory_order_relaxed) < 64)
+        {
+            std::cerr << "QREP_EVENT route=" << (ttReturn ? "tt" : "final")
+                      << " pv=" << PvNode << " check=" << bool(pos.checkers())
+                      << " ply=" << ss->ply << " pieces=" << pos.count<ALL_PIECES>()
+                      << " rule50=" << pos.rule50_count()
+                      << " alpha_in=" << diagnosticInputAlpha << " beta_in=" << diagnosticInputBeta
+                      << " alpha_now=" << alpha << " returned=" << returned
