+    ~RepetitionDiagnostic() {
+        std::cerr << "QREP_TOTAL detected=" << detected.load()
+                  << " continued=" << continued.load()
+                  << " tt_below=" << ttBelow.load()
+                  << " final_below=" << finalBelow.load()
+                  << " logged=" << std::min(u64(64), samples.load()) << '\n';
+    }
+} repetitionDiagnostic;
