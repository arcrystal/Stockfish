     assert(alpha >= -VALUE_INFINITE && alpha < beta && beta <= VALUE_INFINITE);
     assert(PvNode || (alpha == beta - 1));
 
+    const Value diagnosticInputAlpha = alpha;
+    const Value diagnosticInputBeta  = beta;
+    Value diagnosticRepetitionValue = -VALUE_INFINITE;
+
     // Check if we have an upcoming move that draws by repetition
     if (alpha < VALUE_DRAW && pos.upcoming_repetition(ss->ply))
     {
         alpha = value_draw(nodes);
+        diagnosticRepetitionValue = alpha;
+        repetitionDiagnostic.detected.fetch_add(1, std::memory_order_relaxed);
